PORT=3000
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRY=30d

# HesabPay
HESABPAY_API_URL=https://api.hesabpay.com
HESABPAY_MERCHANT_ID=your-merchant-id
HESABPAY_SECRET_KEY=your-secret-key
HESABPAY_CALLBACK_URL=https://yourdomain.com/api/payments/hesabpay/webhook

# MoMo
MOMO_API_URL=https://api.momo.af
MOMO_API_KEY=your-momo-api-key
MOMO_MERCHANT_ID=your-momo-merchant-id
MOMO_CALLBACK_URL=https://yourdomain.com/api/payments/momo/webhook

# PayPal
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

# Firebase (FCM)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# Twilio / SMS Provider
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Frontend URL (for payment redirects)
FRONTEND_URL=https://yourdomain.com
